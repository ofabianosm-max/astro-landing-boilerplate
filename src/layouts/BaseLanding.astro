---
import '@/styles/global.css';
import type { SiteConfig } from '@/schemas/site.schema';
import BaseHead from '@/components/seo/BaseHead.astro';
import Header from '@/components/sections/Header.astro';
import WhatsAppButton from '@/components/seo/WhatsAppButton.astro';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <BaseHead config={config}>
      <slot name="head-extra" slot="head-extra" />
    </BaseHead>
  </head>
  <body
    style={`--color-primary: ${config.brand.primaryColor}; font-family: ${config.brand.fontFamily}, sans-serif;`}
    class="bg-white text-gray-900 antialiased"
  >
    <Header
      logo={config.brand.logoLight}
      businessName={config.nap.businessName}
      ctaLabel={config.nav.ctaLabel}
      ctaUrl={config.nav.ctaUrl}
      navLinks={config.nav.navLinks}
    />
    <slot />

    {config.integrations.whatsappCta && config.nap.whatsapp && (
      <WhatsAppButton whatsapp={config.nap.whatsapp} message="Olá! Vim pelo site e gostaria de mais informações." />
    )}

    {config.integrations.googleAnalytics && (
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${config.integrations.googleAnalytics}`}
      />
    )}
    {config.integrations.googleAnalytics && (
      <script is:inline define:vars={{ gaId: config.integrations.googleAnalytics }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}

    {config.integrations.googleTagManager && (
      <script
        is:inline
        define:vars={{ gtmId: config.integrations.googleTagManager }}
        dangerouslySetInnerHTML={{
          __html: `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer',gtmId);`
        }}
      />
    )}

    {config.integrations.facebookPixel && (
      <script define:vars={{ pixelId: config.integrations.facebookPixel }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}

    {config.integrations.googleTagManager && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${config.integrations.googleTagManager}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
  </body>
</html>
