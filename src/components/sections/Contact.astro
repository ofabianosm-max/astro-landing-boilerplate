---
interface ContactProps {
  sectionTitle: string;
  sectionSubtitle?: string;
  whatsapp: string;
  email: string;
  emailSubject?: string;
  image?: string;
  imageAlt?: string;
  background?: 'white' | 'gray';
}

interface Props extends ContactProps {}

const {
  sectionTitle,
  sectionSubtitle,
  whatsapp,
  email,
  emailSubject = 'Contato pelo site',
  image,
  imageAlt = 'Imagem de contato',
  background = 'white',
} = Astro.props;

const bgClasses = {
  white: 'bg-white',
  gray: 'bg-[#f8fafc]',
};

const textClasses = {
  white: 'text-gray-900',
  gray: 'text-gray-900',
};

const subtitleClasses = {
  white: 'text-gray-600',
  gray: 'text-gray-600',
};

const whatsappIcon = `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`;

const emailIcon = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`;
---

<section id="contact" class={`py-16 md:py-24 ${bgClasses[background]}`}>
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class={`text-3xl md:text-4xl font-bold mb-4 ${textClasses[background]}`}>
        {sectionTitle}
      </h2>
      {sectionSubtitle && (
        <p class={`text-lg max-w-2xl mx-auto ${subtitleClasses[background]}`}>
          {sectionSubtitle}
        </p>
      )}
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
      {/* Imagem - 40% */}
      {image && (
        <div class="order-1">
          <img
            src={image}
            alt={imageAlt}
            loading="lazy"
            class="w-full h-auto rounded-2xl shadow-xl object-cover aspect-[4/3]"
          />
        </div>
      )}

      {/* Formulário - 60% ou 100% se sem imagem */}
      <div class={image ? 'order-2' : 'order-1'}>
        <div id="contact-form-container">
          <form id="contact-form" class="space-y-4" data-whatsapp={whatsapp}>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="nome" class="block text-sm font-medium text-gray-700 mb-1">Nome *</label>
                <input
                  type="text"
                  id="nome"
                  name="nome"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                  placeholder="Seu nome"
                />
                <p class="text-red-500 text-sm mt-1 hidden" data-error="nome">Campo obrigatório</p>
              </div>
              <div>
                <label for="sobrenome" class="block text-sm font-medium text-gray-700 mb-1">Sobrenome *</label>
                <input
                  type="text"
                  id="sobrenome"
                  name="sobrenome"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                  placeholder="Seu sobrenome"
                />
                <p class="text-red-500 text-sm mt-1 hidden" data-error="sobrenome">Campo obrigatório</p>
              </div>
            </div>

            <div>
              <label for="telefone" class="block text-sm font-medium text-gray-700 mb-1">Telefone *</label>
              <input
                type="tel"
                id="telefone"
                name="telefone"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                placeholder="(00) 00000-0000"
              />
              <p class="text-red-500 text-sm mt-1 hidden" data-error="telefone">Campo obrigatório</p>
            </div>

            <div>
              <label for="mensagem" class="block text-sm font-medium text-gray-700 mb-1">Mensagem *</label>
              <textarea
                id="mensagem"
                name="mensagem"
                required
                rows="4"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all resize-none"
                placeholder="Como podemos ajudar?"
              ></textarea>
              <p class="text-red-500 text-sm mt-1 hidden" data-error="mensagem">Campo obrigatório</p>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 rounded-lg font-semibold text-white transition-all hover:scale-105"
              style="background-color: var(--color-primary);"
            >
              <span set:html={whatsappIcon} />
              Enviar pelo WhatsApp
            </button>
          </form>

          <div class="mt-6 pt-6 border-t border-gray-200">
            <p class="text-center text-sm text-gray-500 mb-4">ou fale direto por:</p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a
                href={`https://wa.me/${whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold border-2 border-[#25D366] text-[#25D366] hover:bg-[#25D366] hover:text-white transition-all"
              >
                <span set:html={whatsappIcon} />
                Chamar no WhatsApp
              </a>
              <a
                href={`mailto:${email}?subject=${encodeURIComponent(emailSubject)}`}
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold border-2 border-gray-300 text-gray-700 hover:border-gray-400 hover:bg-gray-50 transition-all"
              >
                <span set:html={emailIcon} />
                Enviar por Email
              </a>
            </div>
          </div>
        </div>

        {/* Success Message */}
        <div id="success-message" class="hidden text-center py-12">
          <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Mensagem enviada!</h3>
          <p class="text-gray-600 mb-6">Em breve entraremos em contato.</p>
          <button
            id="reset-form-btn"
            type="button"
            class="px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-all"
          >
            Enviar nova mensagem
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Phone mask
  const phoneInput = document.getElementById('telefone');
  if (phoneInput) {
    phoneInput.addEventListener('input', (e) => {
      let v = (e.target as HTMLInputElement).value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 6) {
        v = `(${v.slice(0,2)}) ${v.slice(2,7)}-${v.slice(7)}`;
      } else if (v.length > 2) {
        v = `(${v.slice(0,2)}) ${v.slice(2)}`;
      } else if (v.length > 0) {
        v = `(${v}`;
      }
      (e.target as HTMLInputElement).value = v;
    });
  }

  // Form validation and submission
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const formContainer = document.getElementById('contact-form-container');
  const successMessage = document.getElementById('success-message');
  const resetBtn = document.getElementById('reset-form-btn');

  function showError(fieldId: string, message: string) {
    const input = document.getElementById(fieldId);
    const errorMsg = document.querySelector(`[data-error="${fieldId}"]`);
    if (input) input.classList.add('border-red-500');
    if (errorMsg) {
      errorMsg.textContent = message;
      errorMsg.classList.remove('hidden');
    }
  }

  function clearError(fieldId: string) {
    const input = document.getElementById(fieldId);
    const errorMsg = document.querySelector(`[data-error="${fieldId}"]`);
    if (input) input.classList.remove('border-red-500');
    if (errorMsg) errorMsg.classList.add('hidden');
  }

  function validateForm() {
    let isValid = true;
    const fields = ['nome', 'sobrenome', 'telefone', 'mensagem'];

    fields.forEach(f => clearError(f));

    const nome = (document.getElementById('nome') as HTMLInputElement)?.value.trim();
    const sobrenome = (document.getElementById('sobrenome') as HTMLInputElement)?.value.trim();
    const telefone = (document.getElementById('telefone') as HTMLInputElement)?.value.trim();
    const mensagem = (document.getElementById('mensagem') as HTMLTextAreaElement)?.value.trim();

    if (!nome) { showError('nome', 'Campo obrigatório'); isValid = false; }
    if (!sobrenome) { showError('sobrenome', 'Campo obrigatório'); isValid = false; }
    if (!telefone) { showError('telefone', 'Campo obrigatório'); isValid = false; }
    if (!mensagem) { showError('mensagem', 'Campo obrigatório'); isValid = false; }

    return isValid;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    if (!validateForm()) return;

    const whatsapp = form.dataset.whatsapp;
    const nome = (document.getElementById('nome') as HTMLInputElement).value.trim();
    const sobrenome = (document.getElementById('sobrenome') as HTMLInputElement).value.trim();
    const telefone = (document.getElementById('telefone') as HTMLInputElement).value.trim();
    const mensagem = (document.getElementById('mensagem') as HTMLTextAreaElement).value.trim();

    const waMessage = `Olá! Vim pelo site.
Nome: ${nome} ${sobrenome}
Telefone: ${telefone}
Mensagem: ${mensagem}`;

    window.open(
      `https://wa.me/${whatsapp}?text=${encodeURIComponent(waMessage)}`,
      '_blank'
    );

    // Show success
    formContainer?.classList.add('hidden');
    successMessage?.classList.remove('hidden');
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    successMessage?.classList.add('hidden');
    formContainer?.classList.remove('hidden');
  });
</script>
