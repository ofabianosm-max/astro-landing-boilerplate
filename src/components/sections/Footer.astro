---
import type { SiteConfig } from '@/schemas/site.schema';

interface FooterProps {
  showMap?: boolean;
  showHours?: boolean;
  copyrightText?: string;
  links?: Array<{
    label: string;
    url: string;
  }>;
}

interface Props extends FooterProps {
  config: SiteConfig;
}

const {
  config,
  showMap = true,
  showHours = true,
  copyrightText,
  links = [],
} = Astro.props;

const currentYear = new Date().getFullYear();
const businessName = config.nap.businessName;
const copyright = copyrightText || `© ${currentYear} ${businessName}. Todos os direitos reservados.`;

const socialIcons: Record<string, string> = {
  instagram: '<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>',
  facebook: '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>',
  google: '<path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.876 0 .307 5.387.307 12s5.57 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>',
  linkedin: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
};

const schemaOrgType = config.niche === 'clinica' ? 'MedicalBusiness' : 'LocalBusiness';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaOrgType,
  name: config.nap.businessName,
  telephone: config.nap.phone,
  email: config.nap.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${config.nap.address.street}, ${config.nap.address.number}`,
    addressLocality: config.nap.address.city,
    addressRegion: config.nap.address.state,
    postalCode: config.nap.address.zip,
    addressCountry: config.nap.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: config.nap.geo.lat,
    longitude: config.nap.geo.lng,
  },
  openingHoursSpecification: config.nap.openingHours.map(h => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.split(' ')[0],
    opens: h.split(' ')[1]?.split('-')[0],
    closes: h.split(' ')[1]?.split('-')[1],
  })),
  url: config.site.url,
  sameAs: [config.social.instagram, config.social.facebook, config.social.google, config.social.linkedin].filter(Boolean),
};

const mapsUrl = `https://www.google.com/maps?q=${config.nap.geo.lat},${config.nap.geo.lng}`;
---

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<footer class="bg-[#0f172a] text-white">
  <div class="container mx-auto px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12">
      {/* Coluna 1: Logo + Sobre + Redes */}
      <div>
        {config.brand.logoLight && (
          <img
            src={config.brand.logoLight}
            alt={config.nap.businessName}
            class="h-10 mb-4 brightness-0 invert"
          />
        )}
        <h3 class="text-lg font-bold mb-2">{config.nap.businessName}</h3>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          {config.site.description}
        </p>
        <div class="flex gap-2">
          {config.social.instagram && (
            <a
              href={config.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-[var(--color-primary)] transition-colors"
              aria-label="Instagram"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {config.social.facebook && (
            <a
              href={config.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-[var(--color-primary)] transition-colors"
              aria-label="Facebook"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {config.social.linkedin && (
            <a
              href={config.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-[var(--color-primary)] transition-colors"
              aria-label="LinkedIn"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      {/* Coluna 2: Links Rápidos */}
      <div>
        <h4 class="text-base font-semibold mb-4">Links Rápidos</h4>
        <ul class="space-y-2">
          {config.nav.navLinks.map((link) => (
            <li>
              <a
                href={link.anchor}
                class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
          {links.map((link) => (
            <li>
              <a
                href={link.url}
                class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Coluna 3: Contato */}
      <div>
        <h4 class="text-base font-semibold mb-4">Contato</h4>
        <address class="not-italic text-sm text-gray-400 space-y-3">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>
              {config.nap.address.street}, {config.nap.address.number} - {config.nap.address.neighborhood}<br />
              {config.nap.address.city} - {config.nap.address.state}
            </span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${config.nap.phone}`} class="hover:text-[var(--color-primary)] transition-colors">
              {config.nap.phone}
            </a>
          </p>
          {config.nap.email && (
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 flex-shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <a href={`mailto:${config.nap.email}`} class="hover:text-[var(--color-primary)] transition-colors">
                {config.nap.email}
              </a>
            </p>
          )}
        </address>
      </div>

      {/* Coluna 4: Horários */}
      <div>
        {showHours && config.nap.openingHours.length > 0 && (
          <div class="mb-4">
            <h4 class="text-base font-semibold mb-3">Horário de Funcionamento</h4>
            <ul class="space-y-1 text-sm text-gray-400">
              {config.nap.openingHours.map(h => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        )}

        {showMap && (
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm text-[var(--color-primary)] hover:underline"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            Ver no mapa
          </a>
        )}
      </div>
    </div>
  </div>

  {/* Barra inferior */}
  <div class="border-t border-white/10">
    <div class="container mx-auto px-4 py-6">
      <p class="text-sm text-gray-400 text-center">
        {copyright}
      </p>
    </div>
  </div>
</footer>
