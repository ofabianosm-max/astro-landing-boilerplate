---
interface NavLink {
  label: string;
  anchor: string;
}

interface Props {
  logo: string;
  businessName: string;
  ctaLabel: string;
  ctaUrl: string;
  navLinks: NavLink[];
}

const {
  logo,
  businessName,
  ctaLabel,
  ctaUrl,
  navLinks,
} = Astro.props;
---

<!-- Sentinel for scroll detection -->
<div id="scroll-sentinel" class="absolute top-0 h-px w-full pointer-events-none" aria-hidden="true"></div>

<header
  id="main-header"
  class="sticky top-0 z-50 bg-white transition-all duration-300"
  data-scrolled="false"
>
  <nav
    id="header-nav"
    class="container mx-auto px-4 h-20 md:h-24 flex items-center justify-between transition-all duration-300"
    aria-label="Menu principal"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center h-full gap-3">
      {logo ? (
        <img src={logo} alt={businessName} id="header-logo" class="h-10 md:h-12 brightness-0 opacity-80 transition-all duration-300" />
      ) : (
        <span id="header-logo-text" class="text-2xl md:text-3xl font-bold text-gray-900 transition-all duration-300">{businessName}</span>
      )}
    </a>

    <!-- Desktop Navigation (centered) -->
    <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.anchor}
          class="text-sm font-medium text-gray-700 hover:text-[var(--color-primary)] transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center h-full">
      <a
        href={ctaUrl}
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg font-semibold text-sm text-white transition-all hover:scale-105"
        style="background-color: var(--color-primary);"
      >
        {ctaLabel}
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden flex items-center h-full p-2 -mr-2 text-gray-700 hover:text-[var(--color-primary)]"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
    >
      <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 bg-white z-50 hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu de navegação"
  >
    <div class="absolute top-4 right-4">
      <button
        id="mobile-menu-close"
        type="button"
        class="p-2 text-gray-700 hover:text-[var(--color-primary)]"
        aria-label="Fechar menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="flex flex-col items-center justify-center h-full gap-8 -mt-16">
      {navLinks.map((link) => (
        <a
          href={link.anchor}
          class="mobile-nav-link text-2xl font-semibold text-gray-900 hover:text-[var(--color-primary)] transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href={ctaUrl}
        class="mt-4 inline-flex items-center justify-center px-8 py-3 rounded-lg font-semibold text-white"
        style="background-color: var(--color-primary);"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</header>

<script>
  // Scroll shrink effect
  const sentinel = document.getElementById('scroll-sentinel');
  const header = document.getElementById('main-header');
  const nav = document.getElementById('header-nav');
  const logo = document.getElementById('header-logo');
  const logoText = document.getElementById('header-logo-text');

  if (sentinel && header) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const isScrolled = !entry.isIntersecting;
        header.dataset.scrolled = String(isScrolled);
        header.classList.toggle('shadow-md', isScrolled);
        nav?.classList.toggle('h-16', isScrolled);
        nav?.classList.toggle('md:h-18', isScrolled);
        nav?.classList.toggle('py-2', isScrolled);
        logo?.classList.toggle('h-8', isScrolled);
        logo?.classList.toggle('md:h-9', isScrolled);
        logoText?.classList.toggle('text-xl', isScrolled);
        logoText?.classList.toggle('md:text-2xl', isScrolled);
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);
  }

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
    menuIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      closeMenu();
    }
  });

  // Close on mobile link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  #mobile-menu {
    animation: fadeIn 200ms ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
